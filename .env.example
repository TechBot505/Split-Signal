# Split Signal — environment variables
# EVERYTHING here is OPTIONAL. With no env vars the app runs in guest mode:
# local dev serves the web app on :3000 and the wrangler realtime worker on :8787,
# history is stored locally in the browser, and sign-in is hidden. Empty strings
# are treated as unset. Copy to .env.local to enable more.

# --- Realtime (Cloudflare Workers / partyserver) ---------------------------
# Host of the realtime worker the browser connects to. Local dev default below.
# In prod use your deployed host, e.g. splitsignal.<your-subdomain>.workers.dev
NEXT_PUBLIC_REALTIME_HOST=localhost:8787

# Public URL of THIS Next.js app. The realtime worker POSTs finished runs to
# `${NEXT_PUBLIC_APP_URL}/api/runs`. Set on your host to the deployment URL and,
# on the worker, via `wrangler.jsonc` vars or `wrangler secret put NEXT_PUBLIC_APP_URL`.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Shared secret authenticating the realtime worker -> POST /api/runs. Generate a
# long random value. Set it in BOTH the web host and the worker
# (`npx wrangler secret put REALTIME_SECRET`, or `.dev.vars` locally). Leave unset
# to disable cloud run saving (the POST is a no-op and the route 401s).
REALTIME_SECRET=

# --- Database (Neon / any Postgres) ---------------------------------------
# Postgres connection string. Use the Neon POOLED connection string (host with
# `-pooler`) since we run with prepare:false / pgbouncer. Leave unset to disable
# all cloud persistence (API routes then return 503 { reason: "db_disabled" }).
# Example (placeholder — replace all parts):
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require
#
# LOCAL DEV (no Docker): run `npm run db:local` to start an embedded PGlite
# Postgres on 127.0.0.1:5433 (fallback 54339); it prints a ready-to-use
# DATABASE_URL. `npm run dev:full` wires that URL into `next dev` for you.
DATABASE_URL=

# --- Auth (Clerk) — OPTIONAL ----------------------------------------------
# Set BOTH keys to enable sign-in (cloud profile + claimable run history).
# Get them from the Clerk dashboard. If either is missing, auth stays disabled.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Where Clerk's sign-in / sign-up UI lives (matches the app's route folders).
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Where Clerk sends users after signing in / up when there is no redirect target.
# `/play` lands them straight back in the game hub.
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/play
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/play
