{
  "name": "splitsignal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n web,rt \"next dev\" \"wrangler dev --port 8787\"",
    "dev:web": "next dev",
    "dev:rt": "wrangler dev --port 8787",
    "dev:full": "concurrently -n db,web,rt \"node scripts/dev-db.mjs\" \"DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/postgres next dev\" \"wrangler dev --port 8787\"",
    "build": "next build",
    "start": "next start",
    "rt:deploy": "wrangler deploy",
    "db:local": "node scripts/dev-db.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "lint": "eslint",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker/tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@clerk/nextjs": "7.9.7",
    "canvas-confetti": "1.9.4",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.3",
    "lucide-react": "1.48.0",
    "motion": "13.4.4",
    "nanoid": "5.1.16",
    "next": "15.5.26",
    "partyserver": "0.5.10",
    "partysocket": "1.3.0",
    "postgres": "3.4.9",
    "qrcode": "1.5.4",
    "react": "19.1.4",
    "react-dom": "19.1.4",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260702.1",
    "@electric-sql/pglite": "0.5.8",
    "@electric-sql/pglite-socket": "0.2.11",
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/canvas-confetti": "1.9.0",
    "@types/node": "^20",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "8.18.1",
    "concurrently": "9.2.4",
    "drizzle-kit": "0.31.11",
    "eslint": "^9",
    "eslint-config-next": "15.5.26",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "^5",
    "vitest": "4.1.11",
    "wrangler": "4.86.0",
    "ws": "8.22.0"
  },
  "engines": {
    "node": ">=20.9"
  }
}
